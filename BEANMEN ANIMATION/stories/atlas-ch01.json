      "transition": "cut",
      "sfx": [
        "magic"
      ],
      "fx": [
        "sparkle"
      ]
    },
    {
      "say": "Yet on the night recorded in our oldest texts as the Grand Fracture, the obsidian vault of the firmament shattered like frosted glass.",
