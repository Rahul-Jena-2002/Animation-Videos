      "transition": "cut",
      "sfx": [
        "boom"
      ],
      "fx": [
        "shake"
      ]
    },
    {
      "say": "One by one, the seven stars tore free from the celestial spheres, blazing across the terrified world like descending comets of incandescent wrath.",
