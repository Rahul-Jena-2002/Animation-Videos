      "camera": "pullOut",
      "transition": "dissolve",
      "sfx": [
        "magic"
      ],
      "fx": [
        "sparkle"
      ]
    },
    {
      "say": "They were not mere burning spheres of gas, but sentient manifestations of the foundational laws: Life, Death, Time, Memory, Light, Shadow, and Creation.",
