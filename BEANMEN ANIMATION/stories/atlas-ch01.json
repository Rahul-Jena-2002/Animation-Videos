      "actors": [],
      "camera": "panRight",
      "transition": "cut",
      "sfx": [
        "footsteps"
      ],
      "fx": []
    },
    {
      "say": "For ten thousand unbroken years, human kingdoms flourished beneath their luminous canopy, charting destiny across rivers of starlight.",
